# ===========================================
# kTracker Environment Configuration
# ===========================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control
# ===========================================

# ===========================================
# Backend Configuration
# ===========================================

# Database Connection
# SQLite (default for development):
DATABASE_URL="file:./backend/prisma/dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/ktracker?schema=public"

# Server Configuration
PORT=3000
NODE_ENV="development"

# JWT Authentication
# Generate a secure random secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ===========================================
# Frontend Configuration
# ===========================================

# API URL (frontend uses this to call backend)
VITE_API_URL="http://localhost:3000/api"

# Application Title
VITE_APP_TITLE="kTracker"

# ===========================================
# Optional: PostgreSQL Configuration
# ===========================================
# Uncomment and configure for PostgreSQL instead of SQLite
# POSTGRES_HOST="localhost"
# POSTGRES_PORT="5432"
# POSTGRES_USER="ktracker"
# POSTGRES_PASSWORD="your-secure-password"
# POSTGRES_DATABASE="ktracker"

# ===========================================
# Optional: CORS Configuration
# ===========================================
# CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ===========================================
# Optional: Logging
# ===========================================
# LOG_LEVEL="info"

# NOTE: PostgreSQL support is ready. To switch from SQLite to PostgreSQL:
# 1. Install PostgreSQL: brew install postgresql (Mac) or apt-get install postgresql (Linux)
# 2. Create database: createdb ktracker
# 3. Update DATABASE_URL above with PostgreSQL connection string
# 4. Run: npx prisma migrate dev
# 5. For Docker deployment, see docker-compose.yml
