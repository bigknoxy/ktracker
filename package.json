{
  "name": "ktracker",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "prepare": "husky install",
    "db:seed": "bunx tsx backend/prisma/seed.ts",
