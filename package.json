    "test:e2e": "npm run test:setup && npm run dev:test & sleep 5 && cd frontend && npm run test:e2e",
    "test:e2e:ci": "npm run test:setup && npm run dev:test & sleep 5 && cd frontend && npm run test:e2e:ci",
    "dev:test": "NODE_ENV=test DATABASE_URL='file:/home/josh/projects/kTracker/backend/prisma/test.db' JWT_SECRET='test-jwt-secret' bun index.ts",
    "test:cleanup": "rm -f backend/prisma/test.db",
    "docs:open": "open docs/API.md"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@prisma/client": "^7.10.0",
    "@types/bcrypt": "^6.0.0",
